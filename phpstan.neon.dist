includes:
    - vendor/szepeviktor/phpstan-wordpress/extension.neon
    - phpstan-baseline.neon

parameters:
    # Constitution §III / §VII mandate level 8. The baseline below records the
    # pre-existing debt so the gate runs TODAY and fails on anything new; the
    # backlog is paid down separately. Before 2026-10-07 this file bootstrapped
    # the plugin entry point, whose `defined( 'WPINC' ) || die` exited PHP
    # before analysis — every green run examined zero files (F095 T085).
    level: 8

    paths:
        - includes/
        - admin/
        - public/
        - acrossai-mcp-manager.php

    excludePaths:
        - vendor/ (?)
        - node_modules/ (?)

    bootstrapFiles:
        - phpstan-bootstrap.php

    # 1G: the default 128M is exhausted part-way through this codebase, and a
    # partial run reports "incomplete" rather than failing loudly.


    universalObjectCratesClasses:
        - stdClass
